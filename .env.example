# Form handler (Web3Forms or Formspree). Exposed at build time, must be PUBLIC_*
PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# Site
PUBLIC_SITE_URL=https://allegra.indonesiaistimewastudio.id
PUBLIC_WHATSAPP_NUMBER=62XXXXXXXXXXX
PUBLIC_CONTACT_EMAIL=allegrachamberbali@gmail.com
PUBLIC_INSTAGRAM=https://instagram.com/your-handle

# Analytics (optional)
PUBLIC_PLAUSIBLE_DOMAIN=allegra.indonesiaistimewastudio.id
# PUBLIC_GA4_ID=G-XXXXXXX

# Cloudflare Workers AI — used by scripts/generate-cover-image.mjs (build-time only,
# never called at runtime — the site stays static per CLAUDE.md rule #7).
# Token needs "Workers AI - Read" permission, scoped to this account.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token

# Google Ads API (Keyword Planner) — used by scripts/gkp.mjs (local research only, never
# at build/runtime). OAuth client type "Desktop app"; fill the refresh token with
# `npm run gkp:auth` (writes it into .env for you). The Cloud project that owns this OAuth
# client needs Basic access (Test/Explorer block Keyword Planner) — apply at
# console.cloud.google.com/google/ads-apis/overview. Developer tokens were sunset
# 2026-09-09; the variable is optional and ignored by the API.
# GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=
# Ads account the Keyword Planner runs under (digits only or 123-456-7890)
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Only when access goes through a manager (MCC) account — the MCC's own ID
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25
