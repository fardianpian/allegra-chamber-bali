---
import { getImage } from 'astro:assets'
import Eyebrow from '../ui/Eyebrow.astro'
import Button from '../ui/Button.astro'
import WhatsAppCTA from '../media/WhatsAppCTA.astro'
import { useTranslations } from '../../i18n/utils'
import type { Lang } from '../../i18n/languages'
import slide1 from '../../assets/hero/cliffside-ceremony-setup.jpg'
import slide2 from '../../assets/hero/beachfront-wedding-setup.jpg'
import slide3 from '../../assets/hero/glass-chapel-wedding-venue.jpg'
import slide4 from '../../assets/hero/ballroom-reception-setup.jpg'
import slide5 from '../../assets/hero/reception-table-setup.jpg'
import slide6 from '../../assets/hero/violinist-hands-wedding.jpg'

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const hero = t('hero')
const whatsappMessage = t('whatsappMessage')

// Hero copy deliberately has no .reveal class: .reveal holds text at opacity 0 until the
// IntersectionObserver fires, and the H1 is the page's LCP element (Lighthouse measured 1.4–1.8s
// of render delay from it, 2026-10-07).

// Decorative slideshow — the H1/subhead already convey the content, so slides use
// alt="" rather than competing descriptions for screen readers.
const slides = [slide1, slide2, slide3, slide4, slide5, slide6]
const SLOT_SECONDS = 6
const CYCLE_SECONDS = slides.length * SLOT_SECONDS

// Responsive srcset so phones don't download the 1920px source for the LCP image.
const HERO_WIDTHS = [640, 1024, 1600, 1920]
const optimizedSlides = await Promise.all(
	slides.map((src) =>
		getImage({ src, width: 1920, height: 1080, widths: HERO_WIDTHS, format: 'avif', quality: 70 }),
	),
)
// Slides 2–6 sit inside the viewport (absolute inset-0), so loading="lazy" never actually defers
// them and they compete with the LCP slide for bandwidth. They start on a 1×1 placeholder and get
// their real src after window load (see script below).
const PLACEHOLDER_SRC = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
---

<section class="relative flex min-h-[88vh] items-end overflow-hidden">
	<div class="absolute inset-0 h-full w-full" style={`--hero-cycle: ${CYCLE_SECONDS}s`}>
		{
			optimizedSlides.map((img, i) =>
				i === 0 ? (
					<img
						src={img.src}
						srcset={img.srcSet.attribute}
						sizes="100vw"
						alt=""
						width={1920}
						height={1080}
						fetchpriority="high"
						decoding="async"
						class="hero-slide absolute inset-0 h-full w-full object-cover"
						style={`animation-delay: ${i * SLOT_SECONDS}s`}
					/>
				) : (
					<img
						src={PLACEHOLDER_SRC}
						data-hero-src={img.src}
						data-hero-srcset={img.srcSet.attribute}
						sizes="100vw"
						alt=""
						width={1920}
						height={1080}
						decoding="async"
						class="hero-slide absolute inset-0 h-full w-full object-cover"
						style={`animation-delay: ${i * SLOT_SECONDS}s`}
					/>
				),
			)
		}
	</div>
	<div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/40 to-ink/15"></div>

	<div class="container-max relative z-10 pb-20 pt-36 text-ivory">
		<Eyebrow class="text-ivory/80">{hero.eyebrow}</Eyebrow>
		<h1 class="mt-4 max-w-3xl text-6xl md:text-7xl lg:max-w-none lg:text-8xl">
			{hero.titleTagline}
		</h1>
		{/* Brand name kept outside the H1 so the heading reads as one keyword phrase. */}
		<p class="font-body mt-2 text-xl text-ivory/80 md:text-2xl">{hero.title}</p>
		<p class="mt-6 max-w-xl text-lg text-ivory/85 md:text-xl">{hero.subhead}</p>
		<div class="mt-9 flex flex-wrap gap-4">
			<WhatsAppCTA location="hero" message={whatsappMessage} label={hero.ctaPrimary} variant="gold" />
			<Button href="#featured-audio" variant="ghost">{hero.ctaSecondary}</Button>
		</div>
	</div>
</section>

<script>
	// Reduced-motion visitors only ever see slide 1 (see styles below), so the other slides never
	// need to download for them.
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const loadDeferredSlides = () => {
			document.querySelectorAll<HTMLImageElement>('img[data-hero-src]').forEach((img) => {
				img.srcset = img.dataset.heroSrcset ?? ''
				img.src = img.dataset.heroSrc ?? img.src
			})
		}
		if (document.readyState === 'complete') loadDeferredSlides()
		else window.addEventListener('load', loadDeferredSlides, { once: true })
	}
</script>

<style>
	/* Static fallback: first slide visible, rest hidden — also the reduced-motion state. */
	.hero-slide {
		opacity: 0;
	}
	.hero-slide:first-child {
		opacity: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-slide {
			animation: hero-fade var(--hero-cycle) infinite;
		}
		.hero-slide:first-child {
			opacity: 0;
		}
	}

	/* Same keyframes for every slide; animation-delay (set inline per slide) staggers
	   each one's turn since they all share one cycle length. */
	@keyframes hero-fade {
		0%,
		100% {
			opacity: 0;
		}
		2% {
			opacity: 1;
		}
		14% {
			opacity: 1;
		}
		16% {
			opacity: 0;
		}
	}
</style>
