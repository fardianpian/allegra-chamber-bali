---
// "Lock Your Date" form (step 2, after the terms page) — posts to the Google Apps Script booking
// register (integrations/booking/Code.gs), which records the couple, the terms version they agreed
// to, and emails a confirmation. No payment is taken here. With JavaScript the result is shown
// inline; without it the browser lands on the script's plain confirmation page.
import { useTranslations } from '../../i18n/utils'
import type { Lang } from '../../i18n/languages'
import { site, waLink } from '../../lib/site'
import terms from '../../data/booking-terms.json'

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const copy = t('lockDatePage')
const privacyPath = lang === 'en' ? '/privacy/' : '/id/privacy/'
const termsPath = lang === 'en' ? '/lock-your-date/' : '/id/lock-your-date/'
const whatsapp = waLink(
	lang === 'en'
		? "Hi Allegra, I'd like to hold our wedding date."
		: 'Halo Allegra, kami ingin menahan tanggal pernikahan kami.',
)

const fieldClass =
	'mt-1 w-full border-b border-ink/25 bg-transparent px-0 py-2.5 text-ink placeholder:text-ink/30 focus:border-gold focus:outline-none'
const labelClass = 'text-xs uppercase tracking-[0.1em] text-taupe'

const formations = [
	['solo', copy.formationOptions.solo],
	['duo', copy.formationOptions.duo],
	['trio', copy.formationOptions.trio],
	['quartet', copy.formationOptions.quartet],
	['large-ensemble', copy.formationOptions.largeEnsemble],
	['unsure', copy.formationOptions.unsure],
]
const soloInstruments = [
	['', copy.soloInstrumentOptions.unsure],
	['violin', copy.soloInstrumentOptions.violin],
	['cello', copy.soloInstrumentOptions.cello],
	['piano', copy.soloInstrumentOptions.piano],
]
const sessions = [
	['ceremony', copy.sessionOptions.ceremony],
	['cocktail', copy.sessionOptions.cocktail],
	['dinner', copy.sessionOptions.dinner],
]
---

<section class="section bg-ivory pt-0">
	<div class="container-max">
		<div class="reveal mb-10 border-l border-gold pl-5">
			<h2 class="text-xl">{copy.stepsHeading}</h2>
			<ol class="mt-3 list-decimal space-y-1.5 pl-5 text-ink/80">
				{copy.steps.map((step) => <li>{step.replace('{days}', String(terms.holdDays))}</li>)}
			</ol>
		</div>

		{
			site.bookingEndpoint ? (
				<>
					<form
						id="lock-date-form"
						class="reveal grid gap-6"
						action={site.bookingEndpoint}
						method="POST"
						data-errors={JSON.stringify(copy.errors)}
					>
						<input type="hidden" name="lang" value={lang} />
						<input type="hidden" name="terms_version" value={terms.version} />
						<input
							type="checkbox"
							name="botcheck"
							class="hidden"
							style="display:none"
							tabindex="-1"
							autocomplete="off"
							aria-label="Leave this field blank"
						/>

						<label class={labelClass}>
							{copy.name}
							<span class="text-gold" aria-hidden="true">
								*
							</span>
							<input
								type="text"
								name="name"
								required
								maxlength="160"
								autocomplete="name"
								class={fieldClass}
							/>
						</label>

						<div class="grid gap-6 sm:grid-cols-2">
							<label class={labelClass}>
								{copy.email}
								<span class="text-gold" aria-hidden="true">
									*
								</span>
								<input
									type="email"
									name="email"
									required
									maxlength="200"
									autocomplete="email"
									class={fieldClass}
								/>
							</label>
							<label class={labelClass}>
								{copy.whatsapp}
								<span class="text-gold" aria-hidden="true">
									*
								</span>
								<input
									type="tel"
									name="whatsapp"
									required
									maxlength="40"
									autocomplete="tel"
									class={fieldClass}
								/>
							</label>
						</div>

						<div class="grid gap-6 sm:grid-cols-2">
							<label class={labelClass}>
								{copy.weddingDate}
								<span class="text-gold" aria-hidden="true">
									*
								</span>
								<input type="date" name="wedding_date" required class={fieldClass} />
							</label>
							<label class={labelClass}>
								{copy.venue}
								<span class="text-gold" aria-hidden="true">
									*
								</span>
								<input type="text" name="venue" required maxlength="200" class={fieldClass} />
							</label>
						</div>

						<div class="grid gap-6 sm:grid-cols-2">
							<label class={labelClass}>
								{copy.formation}
								<span class="text-gold" aria-hidden="true">
									*
								</span>
								<select name="formation" required class={fieldClass}>
									<option value="" disabled selected>
										{copy.formationOptions.placeholder}
									</option>
									{formations.map(([value, label]) => (
										<option value={value}>{label}</option>
									))}
								</select>
							</label>
							<fieldset data-sessions>
								<legend class={labelClass}>
									{copy.sessions}
									<span class="text-gold" aria-hidden="true">
										*
									</span>
								</legend>
								<div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink">
									{sessions.map(([value, label]) => (
										<label class="flex items-center gap-2">
											<input type="checkbox" name="sessions" value={value} class="h-4 w-4 accent-gold" />
											{label}
										</label>
									))}
								</div>
							</fieldset>
						</div>

						<label class={labelClass} data-solo-instrument>
							{copy.soloInstrument}
							<select name="solo_instrument" class={fieldClass}>
								{soloInstruments.map(([value, label]) => (
									<option value={value}>{label}</option>
								))}
							</select>
						</label>

						<label class={labelClass}>
							{copy.planner}
							<input type="text" name="planner" maxlength="160" class={fieldClass} />
						</label>

						<label class={labelClass}>
							{copy.notes}
							<textarea name="notes" rows="3" maxlength="2000" class={fieldClass} />
						</label>

						<label class="flex items-start gap-3 text-sm text-ink">
							<input
								type="checkbox"
								name="terms_agreed"
								value="yes"
								required
								data-terms-version={terms.version}
								class="mt-1 h-5 w-5 flex-shrink-0 border-ink/25 accent-gold"
							/>
							<span>
								{copy.termsAgree}{' '}
								<a href={termsPath} class="underline decoration-gold underline-offset-4">
									{copy.termsLink}
								</a>
							</span>
						</label>

						<label class="flex items-start gap-3 text-sm text-ink">
							<input
								type="checkbox"
								name="consent"
								value="yes"
								required
								class="mt-1 h-5 w-5 flex-shrink-0 border-ink/25 accent-gold"
							/>
							<span>
								{copy.consent}{' '}
								<a href={privacyPath} class="underline decoration-gold underline-offset-4">
									{copy.privacyLink}
								</a>
							</span>
						</label>

						{site.turnstileSiteKey && (
							<>
								<div
									class="cf-turnstile"
									data-sitekey={site.turnstileSiteKey}
									data-language={lang}
									data-theme="light"
									data-size="flexible"
								/>
								<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
							</>
						)}

						<p data-form-error class="hidden text-sm text-[#9b3b2a]" role="alert" />

						<button
							type="submit"
							data-sending={copy.sending}
							class="inline-flex items-center justify-center gap-2 bg-ink px-7 py-3.5 text-sm uppercase tracking-[0.08em] text-ivory transition-colors duration-300 hover:bg-gold hover:text-ink disabled:opacity-60 sm:w-fit"
						>
							{copy.submit}
						</button>
					</form>

					<div id="lock-date-result" class="hidden scroll-mt-28 border-l border-gold pl-5" aria-live="polite">
						<h2 data-held class="hidden text-2xl">
							{copy.successHeading}
						</h2>
						<h2 data-pending class="hidden text-2xl">
							{copy.pendingHeading}
						</h2>
						<p class="mt-3 text-sm uppercase tracking-[0.1em] text-taupe">
							{copy.referenceLabel}: <span data-reference class="text-ink" />
						</p>
						<p data-held class="mt-3 hidden text-ink/80" data-template={copy.successBody} />
						<p data-pending class="mt-3 hidden text-ink/80" data-template={copy.pendingBody} />
					</div>
				</>
			) : (
				<div class="reveal">
					<p class="text-ink/80">{copy.unavailable}</p>
					<a
						href={whatsapp}
						class="mt-6 inline-flex items-center justify-center bg-ink px-7 py-3.5 text-sm uppercase tracking-[0.08em] text-ivory transition-colors duration-300 hover:bg-gold hover:text-ink"
					>
						{copy.ctaWhatsapp}
					</a>
				</div>
			)
		}
	</div>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('#lock-date-form')
	const result = document.querySelector<HTMLElement>('#lock-date-result')
	if (form && result) {
		const dateInput = form.querySelector<HTMLInputElement>('input[name="wedding_date"]')
		if (dateInput) {
			const tomorrow = new Date()
			tomorrow.setDate(tomorrow.getDate() + 1)
			dateInput.min = tomorrow.toLocaleDateString('en-CA') // yyyy-mm-dd in the visitor's time zone
		}
		// Arriving from the terms page (?agree=<version>) means the couple already agreed to this version.
		const termsBox = form.querySelector<HTMLInputElement>('input[name="terms_agreed"]')
		if (termsBox && new URLSearchParams(location.search).get('agree') === termsBox.dataset.termsVersion) {
			termsBox.checked = true
		}
		const errors: Record<string, string> = JSON.parse(form.dataset.errors || '{}')
		const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
		const label = button.textContent

		// The instrument only matters for Solo; hide it otherwise (it stays visible without JavaScript).
		const formationSelect = form.querySelector<HTMLSelectElement>('select[name="formation"]')!
		const soloField = form.querySelector<HTMLElement>('[data-solo-instrument]')!
		const toggleSolo = () => soloField.classList.toggle('hidden', formationSelect.value !== 'solo')
		formationSelect.addEventListener('change', toggleSolo)
		toggleSolo()

		form.addEventListener('submit', async (event) => {
			event.preventDefault()
			errorBox.classList.add('hidden')
			// Checkboxes cannot be "required as a group" in HTML; the script checks it too.
			if (!form.querySelector('input[name="sessions"]:checked')) {
				errorBox.textContent = errors.sessions
				errorBox.classList.remove('hidden')
				return
			}
			const data = new FormData(form)
			// Turnstile (when enabled) adds its token to the form once the check passes.
			if (form.querySelector('.cf-turnstile') && !data.get('cf-turnstile-response')) {
				errorBox.textContent = errors.verify
				errorBox.classList.remove('hidden')
				return
			}
			button.disabled = true
			button.textContent = button.dataset.sending || label
			data.append('mode', 'js')
			try {
				const res = await fetch(form.action, { method: 'POST', body: data })
				const json = await res.json()
				if (!json.ok) throw new Error(json.error || 'server')
				const state = json.status === 'Pending review' ? 'pending' : 'held'
				const email = String(data.get('email') || '')
				result.querySelector<HTMLElement>('[data-reference]')!.textContent = json.reference
				result.querySelectorAll<HTMLElement>(`[data-${state}]`).forEach((el) => {
					el.classList.remove('hidden')
					if (el.dataset.template) el.textContent = el.dataset.template.replace('{email}', email)
				})
				form.classList.add('hidden')
				result.classList.remove('hidden')
				result.scrollIntoView({ behavior: 'smooth', block: 'start' })
				// `gtag` is the global stub defined inline in BaseLayout (see CLAUDE.md rule #21).
				const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag
				gtag?.('event', 'generate_lead', { form_type: 'lock_date', status: state })
			} catch (err) {
				const code = err instanceof Error ? err.message : 'server'
				errorBox.textContent = errors[code] || errors.server
				errorBox.classList.remove('hidden')
				button.disabled = false
				button.textContent = label
				// A Turnstile token works once; get a fresh one for the next try.
				;(window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset()
			}
		})
	}
</script>
