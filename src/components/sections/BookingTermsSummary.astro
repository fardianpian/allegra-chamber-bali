---
// Step 1 of "Lock Your Date": the booking terms, shown before the form so couples know what they
// agree to (owner direction 2026-10-14). Every number comes from src/data/booking-terms.json. The
// couple's own prices, dates and the bank details follow in their Booking Terms PDF.
// Agreeing is a plain GET form (works without JavaScript): it opens the form page with
// ?agree=<terms version>, which ticks the form's terms box; the form records the version.
import { useTranslations } from '../../i18n/utils'
import type { Lang } from '../../i18n/languages'
import { waLink } from '../../lib/site'
import terms from '../../data/booking-terms.json'

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const copy = t('bookingTermsPage')
const formPath = lang === 'en' ? '/lock-your-date/form/' : '/id/lock-your-date/form/'

const values: Record<string, string | number> = {
	deposit: terms.depositPct,
	balancePct: 100 - terms.depositPct,
	holdDays: terms.holdDays,
	balanceDays: terms.balanceDaysBefore,
	invoiceDays: terms.balanceInvoiceDaysBefore,
	shortDays: terms.balanceDaysBefore + terms.holdDays,
	shortHoldDays: terms.shortNoticeHoldDays,
	coolingHours: terms.coolingOffHours,
	coolingMinDays: terms.coolingOffMinDays,
	dateChangeDays: terms.freeDateChangeDaysBefore,
	creditMonths: terms.creditMonths,
	graceDays: terms.lateGraceDays,
	refundDays: terms.refundWorkingDays,
	version: terms.version,
}
const fill = (text: string, extra: Record<string, string | number> = {}) =>
	text.replace(/\{(\w+)\}/g, (match, key) => String(extra[key] ?? values[key] ?? match))

// Tiers run from furthest to closest; each applies while the wedding is at least `untilDaysBefore` away.
const tiers = terms.tiers as { untilDaysBefore: number; keep?: string; keepPct?: number; credit?: boolean }[]
const cancelRows = tiers.map((tier, i) => {
	const from = i === 0 ? tier.untilDaysBefore : tiers[i - 1].untilDaysBefore - 1
	const when =
		i === 0
			? fill(copy.tierFirst, { from })
			: tier.untilDaysBefore === 0
				? fill(copy.tierLast, { to: from })
				: fill(copy.tierMiddle, { from, to: tier.untilDaysBefore })
	const keep =
		tier.keep === 'deposit'
			? fill(tier.credit ? copy.keepDepositCredit : copy.keepDeposit)
			: tier.keepPct === 100
				? copy.keepFull
				: fill(copy.keepPct, { pct: tier.keepPct ?? 0 })
	return [when, keep]
})

const whatsapp = waLink(
	lang === 'en'
		? 'Hi Allegra, I have a question about the booking terms before we hold our date.'
		: 'Halo Allegra, saya ingin bertanya tentang ketentuan booking sebelum menahan tanggal kami.',
)
const h2 = 'text-xl md:text-2xl'
const list = 'mt-3 list-disc space-y-1.5 pl-5 text-ink/80'
---

<section class="section bg-ivory pt-0">
	<div class="container-max">
		<div class="reveal border-l border-gold pl-5">
			<h2 class={h2}>{copy.availabilityHeading}</h2>
			<p class="mt-3 text-ink/80">{copy.availability}</p>
		</div>

		<div class="reveal mt-10 grid gap-10">
			<div>
				<h2 class={h2}>{copy.howHeading}</h2>
				<ol class="mt-3 list-decimal space-y-1.5 pl-5 text-ink/80">
					{copy.how.map((item) => <li>{fill(item)}</li>)}
				</ol>
			</div>

			<div>
				<h2 class={h2}>{copy.includedHeading}</h2>
				<ul class={list}>
					{copy.included.map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<div>
				<h2 class={h2}>{copy.payHeading}</h2>
				<ul class={list}>
					{copy.pay.map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<div>
				<h2 class={h2}>{copy.changeHeading}</h2>
				<p class="mt-3 text-ink/80">{fill(copy.coolingOff)}</p>
				<table class="mt-4 w-full border-collapse text-left text-sm">
					<thead>
						<tr>
							{
								copy.cancelHead.map((head) => (
									<th class="border-b border-gold py-2 pr-4 text-xs font-normal uppercase tracking-[0.1em] text-taupe">
										{head}
									</th>
								))
							}
						</tr>
					</thead>
					<tbody>
						{
							cancelRows.map(([when, keep]) => (
								<tr class="border-b border-ink/10 align-top">
									<td class="py-2.5 pr-4 text-ink sm:w-2/5">{when}</td>
									<td class="py-2.5 text-ink/80">{keep}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<p class="mt-3 text-sm text-taupe">{copy.cancelNote}</p>
				<ul class={list}>
					<li>{fill(copy.dateChange)}</li>
					<li>{fill(copy.late)}</li>
				</ul>
			</div>

			<div>
				<h2 class={h2}>{copy.usHeading}</h2>
				<ul class={list}>
					{copy.us.map((item) => <li>{fill(item)}</li>)}
				</ul>
			</div>

			<div>
				<h2 class={h2}>{copy.weatherHeading}</h2>
				<ul class={list}>
					{copy.weather.map((item) => <li>{fill(item)}</li>)}
				</ul>
			</div>
		</div>

		<form class="reveal mt-12 border-t border-ink/15 pt-8" action={formPath} method="GET">
			<label class="flex items-start gap-3 text-ink">
				<input
					type="checkbox"
					name="agree"
					value={terms.version}
					required
					class="mt-1 h-5 w-5 flex-shrink-0 border-ink/25 accent-gold"
				/>
				<span>{copy.agree}</span>
			</label>
			<div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
				<button
					type="submit"
					class="inline-flex items-center justify-center bg-ink px-7 py-3.5 text-sm uppercase tracking-[0.08em] text-ivory transition-colors duration-300 hover:bg-gold hover:text-ink sm:w-fit"
				>
					{copy.continue}
				</button>
				<p class="text-sm text-ink/80">
					{copy.question}{' '}
					<a href={whatsapp} class="underline decoration-gold underline-offset-4">{copy.ctaWhatsapp}</a>
				</p>
			</div>
			<p class="mt-6 text-xs text-taupe">{fill(copy.version)}</p>
		</form>
	</div>
</section>
