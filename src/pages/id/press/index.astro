---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PageHeader from '../../../components/sections/PageHeader.astro'
import PressKit from '../../../components/sections/PressKit.astro'
import { useTranslations } from '../../../i18n/utils'
import { getBreadcrumbJsonLd } from '../../../lib/jsonld'

const lang = 'id'
const t = useTranslations(lang)
const page = t('pressPage')
const footer = t('footer')
---

<BaseLayout
	lang={lang}
	title={page.title}
	description={page.description}
	path="/id/press"
	jsonLd={getBreadcrumbJsonLd(lang, [{ name: footer.pressLink, path: '/id/press' }])}
>
	<PageHeader eyebrow={page.eyebrow} heading={page.heading} subhead={page.subhead} />
	<PressKit lang={lang} />
</BaseLayout>
