---
// Step 1 of Lock Your Date: the booking terms. The link Yessica sends opens here; the form is at
// /id/lock-your-date/form/ after the couple agrees (owner direction 2026-10-14).
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PageHeader from '../../../components/sections/PageHeader.astro'
import BookingTermsSummary from '../../../components/sections/BookingTermsSummary.astro'
import { useTranslations } from '../../../i18n/utils'

const lang = 'id'
const t = useTranslations(lang)
const page = t('bookingTermsPage')
---

<BaseLayout lang={lang} title={page.title} description={page.description} path="/id/lock-your-date" noindex>
	<PageHeader eyebrow={page.eyebrow} heading={page.heading} subhead={page.subhead} />
	<BookingTermsSummary lang={lang} />
</BaseLayout>
